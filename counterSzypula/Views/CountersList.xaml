<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="counterSzypula.Views.CountersList"
             Title="CountersList">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add"
                     Clicked="Add_Clicked"
                     IconImageSource="{FontImageSource Glyph='+',
                                                       Color=Black,
                                                       Size=22}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Counters}"
                    Margin="10">

        <CollectionView.EmptyView>
            <Label Text="Nie masz jeszcze zapisanych liczników."
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Margin="0,5"
                        Padding="12">

                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto">

                        <Label Text="{Binding Name}"
                               FontSize="18"
                               FontAttributes="Bold" />

                        <Label Grid.Column="1"
                               Text="{Binding Count}"
                               FontSize="24"
                               VerticalOptions="Center" />

                        <Label Grid.Row="1"
                               Text="{Binding SavedAt,
                                      StringFormat='Zapisano: {0:dd.MM.yyyy HH:mm}'}"
                               FontSize="12" />

                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>